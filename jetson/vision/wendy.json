{
  "appId": "afferent-vision",
  "version": "0.1.0",
  "platform": "linux",
  "env": {
    "DATA_MANAGER_URL": "${DATA_MANAGER_URL}",
    "DATA_MANAGER_TOKEN": "${DATA_MANAGER_TOKEN}"
  },
  "entitlements": [
    {
      "type": "camera"
    },
    {
      "type": "gpu"
    },
    {
      "type": "network",
      "mode": "mesh",
      "serviceCIDR": "10.99.0.0/16",
      "ports": [
        {
          "host": 3005,
          "container": 3005,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "isolation": "isolated"
}
