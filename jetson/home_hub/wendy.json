{
  "appId": "afferent-home-hub",
  "version": "0.1.0",
  "platform": "linux",
  "isolation": "isolated",
  "env": {
    "AFFERENT_BEDSIDE": "unoq:auto",
    "AFFERENT_BEDSIDE_PATIENT": "${AFFERENT_BEDSIDE_PATIENT}",
    "AFFERENT_HOME_PATIENT_NAME": "${AFFERENT_HOME_PATIENT_NAME}",
    "AFFERENT_HOME_TMS_END": "${AFFERENT_HOME_TMS_END}",
    "AFFERENT_HOME_DEMO_ROSTER": "${AFFERENT_HOME_DEMO_ROSTER}",
    "AFFERENT_DATA_MANAGER_URL": "${AFFERENT_DATA_MANAGER_URL}",
    "AFFERENT_DATA_MANAGER_TOKEN": "${AFFERENT_DATA_MANAGER_TOKEN}",
    "AFFERENT_DATA_MANAGER_DEVICE": "${AFFERENT_DATA_MANAGER_DEVICE}",
    "AFFERENT_HUB_TOKEN": "${AFFERENT_HUB_TOKEN}",
    "AFFERENT_HUB_ORIGINS": "${AFFERENT_HUB_ORIGINS}",
    "AFFERENT_HUB_HOSTS": "${AFFERENT_HUB_HOSTS}",
    "TZ": "${AFFERENT_TZ}"
  },
  "entitlements": [
    {
      "type": "network",
      "mode": "mesh",
      "serviceCIDR": "10.99.0.0/16",
      "ports": [
        {
          "host": 18000,
          "container": 8000,
          "protocol": "tcp"
        }
      ]
    },
    {
      "type": "persist",
      "name": "afferent-home-hub",
      "path": "/data"
    }
  ]
}
