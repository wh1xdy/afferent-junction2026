# config.env.example -- copy to modal/config.env (gitignored) and adjust.
# Every value is optional; these are the defaults applied by _common.sh.
#
# Auth is NOT configured here: run `modal token new` once (web OAuth), or
# `modal token set`, or export MODAL_TOKEN_ID / MODAL_TOKEN_SECRET.
# Never put tokens in this file.

# ---- compute -------------------------------------------------------------
MODAL_GPU=A10                          # T4 (cheap) | A10 | L40S | A100-40GB | H100
MODAL_VOLUME=afferent-train            # modal.Volume name (created if missing, v2)
MODAL_TIMEOUT=86400                    # remote function timeout, seconds
#MODAL_PKG=modal==1.6.4                # package spec for the uvx fallback

# ---- run knobs (train.sh) -------------------------------------------------
AMP=1                                  # mixed precision -> make train AMP=1
MAKE_TARGETS="train test"              # add `export evaluate` once test.json exists
#DEVICE=cpu                             # evaluate stays cpu (image has ORT-cpu)
#EXTRA=                                 # extra args appended to every make target

# ---- pull (pull.sh) --------------------------------------------------------
#PULL_DIR=work_dirs                    # local destination dir
#REMOTE_DIR=/work                      # volume path to download
