# config.env.example -- copy to config.env (gitignored) and adjust.
# Every value is optional; these are the defaults applied by _common.sh.
#
# Auth is NOT configured here: run `verda auth login` once (writes
# ~/.verda/credentials), or export VERDA_CLIENT_ID / VERDA_CLIENT_SECRET.
# Never put credentials in this file.

# ---- instance -----------------------------------------------------------
VM_HOSTNAME=afferent-train
INSTANCE_TYPE=1A100.40S.22V            # in-stock check: `verda availability --type 1A100.40S.22V`
                                       # cheap when back: 1V100.4V ($0.24/h, needs OS_IMAGE=*-v100)
LOCATION=FIN-02                        # where INSTANCE_TYPE is in stock; `verda locations`
OS_IMAGE=24.04.cuda13.0.docker         # `verda images` (V100: 24.04.cuda12.9-v100.docker)
OS_VOLUME_SIZE=100                     # GB system disk
#SPOT=1                                # spot instance: cheaper, evictable (default: on-demand)
#EXTRA_CREATE_ARGS=                    # extra flags for `verda vm create`

# ---- ssh / remote layout -------------------------------------------------
SSH_USER=root                          # cuda-*-docker images + `verda ssh` default to root
#SSH_KEY=~/.ssh/id_ed25519              # private key matching the public key on the account
#SSH_KEY_ID=ssh_key_...                 # `verda ssh-key list` — injected at vm create (default: first key)
#SSH_DEST=root@1.2.3.4                  # bypass IP resolution entirely
#SSH_OPTS=-o IdentitiesOnly=yes        # extra ssh options for rsync
REMOTE_ROOT=afferent                   # remote dir: ~/$REMOTE_ROOT/posture-analysis/...

# Register a key once, before up.sh:
#   verda ssh-key add --name laptop --public-key "$(cat ~/.ssh/id_ed25519.pub)"

# ---- dataset -------------------------------------------------------------
# Local dataset root (frames/ + annotations/ as produced by make extract /
# split). Default: posture-analysis/training/data -- leave unset unless the dataset
# lives elsewhere.
#DATA_DIR=/path/to/dataset

# ---- run knobs (train.sh) ------------------------------------------------
AMP=1                                  # mixed precision on the V100
MAKE_TARGETS="train test"              # add export evaluate once test.json exists
#DEVICE=cpu                             # evaluate stays cpu (image has ORT-cpu)
#IMAGE=afferent-train:cu121
#TORCH_VARIANT=cu121
