# Copy to .env and adjust. All values have sane defaults shown.

# Camera: index inside the container (only VIDEO_DEVICE is exposed -> 0),
# a /dev/videoN path, or a video file path for replay.
CAMERA=0
# Host camera node to pass into the container.
VIDEO_DEVICE=/dev/video0

# Requested capture settings (camera may negotiate lower).
WIDTH=1920
HEIGHT=1080
FPS=30

# Pipeline rates.
CONTINUOUS_FPS=10
BURST_FPS=30
# Pose model mode. Leave EMPTY for the device default: lightweight on CPU
# (~4 fps @1080p), balanced on CUDA. Set explicitly to override.
POSE_MODE=
# Detector skip: run YOLOX every N processed frames (empty -> 5 on cpu, 1 on cuda).
DET_EVERY=
DEVICE=cpu                # cpu | cuda (gpu compose override sets cuda)

# Custom fine-tuned pose ONNX from posture-analysis/training `make install-model`
# (lands in ./models/custom/). Empty = stock rtmlib model.
POSE_MODEL_PATH=

# Face identity.
FACE_MATCH_THRESHOLD=0.45 # cosine similarity vs enrolled gallery
LOST_AFTER_S=3
INSIGHTFACE_MODEL=buffalo_l   # buffalo_l | buffalo_s
FACE_DETECT_EVERY=5       # InsightFace detection cadence (processed frames)
FACE_EVERY=1              # MediaPipe landmarker cadence (blendshapes/head pose)
EMOTION_EVERY=10          # HSEmotion cadence on the target crop

# Emotion level-2 (HSEmotion onnx, ~16 MB weights).
EMOTION_ENABLED=1

# Dev-only raw video recording to /recordings (for future fine-tuning data).
RECORDING_ENABLED=0

# Aggregation.
MIN_VALID_FRAMES=30       # min valid frames per minute row

# Room/site id: each site keeps its own floor calibration, upright
# references and aggregates. Switchable at runtime via POST /api/site/<id>
# or the dashboard (the switch persists across restarts).
SITE=default

# Optional: push per-minute trunk / head angles to afferent-data-manager (jetson/data_manager).
# Empty = nothing leaves this machine. The URL must be reachable from inside the container,
# e.g. http://<jetson-ip>:8100 on the same network.
DATA_MANAGER_URL=
DATA_MANAGER_TOKEN=
