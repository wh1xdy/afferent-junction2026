{
  "appId": "afferent-posture",
  "version": "0.1.0",
  "platform": "linux",
  "isolation": "isolated",
  "env": {
    "CAMERA": "auto",
    "WIDTH": "1280",
    "HEIGHT": "720",
    "FPS": "30",
    "CONTINUOUS_FPS": "5",
    "BURST_FPS": "15",
    "DEVICE": "cpu",
    "POSE_MODEL_PATH": "/opt/posture_models/rtmpose-m_halpe26_ft.onnx",
    "SITE": "jetson",
    "EMOTION_ENABLED": "1",
    "RECORDING_ENABLED": "1",
    "RECORD_ANNOTATED": "1",
    "DATA_MANAGER_URL": "http://10.99.0.2:8100",
    "DATA_MANAGER_TOKEN": "${DATA_MANAGER_TOKEN}",
    "PREVIEW_WIDTH": "640",
    "PREVIEW_QUALITY": "55"
  },
  "entitlements": [
    {
      "type": "network",
      "mode": "mesh",
      "serviceCIDR": "10.99.0.0/16",
      "ports": [
        {
          "host": 8000,
          "container": 8000,
          "protocol": "tcp"
        }
      ]
    },
    {
      "type": "camera"
    },
    {
      "type": "persist",
      "name": "afferent-posture",
      "path": "/data"
    },
    {
      "type": "persist",
      "name": "afferent-posture-models",
      "path": "/models"
    },
    {
      "type": "persist",
      "name": "afferent-posture-recordings",
      "path": "/recordings"
    }
  ],
  "readiness": {
    "tcpSocket": {
      "port": 8000
    },
    "timeoutSeconds": 120
  }
}
