# config.env.example -- copy to config.env (gitignored) and adjust.
# Same pattern as posture-analysis/training/verda — see docs/verda_training.md
# (branch poc/laptop-markers) for the full setup walkthrough.
#
# Auth is NOT configured here: run `verda auth login` once (writes
# ~/.verda/credentials), or export VERDA_CLIENT_ID / VERDA_CLIENT_SECRET.
# Never put credentials in this file.

# ---- instance -----------------------------------------------------------
VM_HOSTNAME=afferent-ta-train
INSTANCE_TYPE=1A100.40S.22V                # A100 40 GB — verified in stock FIN-02 (Nov 2026)
                                         # A6000/V100 out of stock Nov 2026; 1A100.22V (80 GB) in FIN-01
                                         # check stock: `verda availability --type $INSTANCE_TYPE`
LOCATION=FIN-02                          # `verda locations`
OS_IMAGE=24.04.cuda13.0.docker           # `verda images` (V100: 24.04.cuda12.9-v100.docker)
OS_VOLUME_SIZE=100                       # GB system disk (8B bf16 merged = ~16 GB + adapter)
#SPOT=1                                  # spot: cheaper, evictable mid-run
#EXTRA_CREATE_ARGS=                      # extra flags for `verda vm create`

# ---- ssh / remote layout -------------------------------------------------
SSH_USER=root                            # cuda-*-docker images + `verda ssh` default to root
#SSH_KEY=~/.ssh/id_ed25519                # private key matching the public key on the account
#SSH_KEY_ID=ssh_key_...                  # `verda ssh-key list` — injected at vm create
#SSH_DEST=root@1.2.3.4                   # bypass IP resolution entirely
#SSH_OPTS=-o IdentitiesOnly=yes          # extra ssh options for rsync
REMOTE_ROOT=afferent                     # remote dir: ~/$REMOTE_ROOT/Transcription_analyzer/...

# Register a key once, before up.sh:
#   verda ssh-key add --name laptop --public-key "$(cat ~/.ssh/id_ed25519.pub)"

# ---- dataset -------------------------------------------------------------
# Local data root (transcripts/*.jsonl from the two-agent simulator).
# Default: Transcription_analyzer/training/data — leave unset unless elsewhere.
#DATA_DIR=/path/to/data
#TRANSCRIPTS=/path/to/data/transcripts

# ---- run knobs (train.sh) ------------------------------------------------
MAKE_TARGETS="dataset train"             # add eval once predictions exist
BASE_MODEL=Qwen/Qwen3-8B                 # student model (dense arch for vanilla QLoRA)
#EXTRA="--epochs 3 --lora-r 32"           # appended to every make target
