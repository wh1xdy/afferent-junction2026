{
  "appId": "afferent-transcription-analyzer",
  "version": "0.1.0",
  "platform": "linux",
  "env": {
    "DATA_MANAGER_URL": "http://10.99.0.2:8100",
    "DATA_MANAGER_TOKEN": "${DATA_MANAGER_TOKEN}"
  },
  "entitlements": [
    {
      "type": "gpu"
    },
    {
      "type": "persist",
      "name": "afferent-transcription-analyzer",
      "path": "/data"
    },
    {
      "type": "persist",
      "name": "afferent-home-hub",
      "path": "/hub-data"
    },
    {
      "type": "network",
      "mode": "mesh",
      "serviceCIDR": "10.99.0.0/16",
      "ports": [
        {
          "host": 3080,
          "container": 3080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "isolation": "isolated",
  "readiness": {
    "tcpSocket": {
      "port": 3080
    },
    "timeoutSeconds": 120
  }
}
