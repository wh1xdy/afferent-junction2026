[
  {
    "id": "q001",
    "text": "Every journey starts with a first step.",
    "author": "Proverb",
    "work": "",
    "year": "",
    "translator": "",
    "source_url": "",
    "tags": [
      "morning"
    ]
  },
  {
    "id": "q002",
    "text": "The journey of a thousand miles begins with one step.",
